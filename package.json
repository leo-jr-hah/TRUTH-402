{
  "name": "truth402",
  "version": "1.0.0",
  "private": true,
  "description": "TRUTH-402: memory-calibrated prediction signals and a custom Sui HTTP-402 alpha exchange.",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "tsx scripts/smoke-demo.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "smoke:browser": "TRUTH402_BROWSER_SMOKE=true tsx scripts/smoke-production.ts",
    "agent:x402": "tsx scripts/x402-agent-client.ts",
    "preflight:mainnet": "tsx scripts/hackathon-preflight.ts",
    "test:network-guard": "node scripts/test-network-guard.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "memories:preview": "tsx scripts/publish-mainnet-memories.ts",
    "memories:publish": "tsx scripts/publish-mainnet-memories.ts",
    "memories:verify": "tsx scripts/verify-mainnet-memories.ts",
    "submission:proof": "tsx scripts/submission-proof.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@grpc/grpc-js": "^1.14.7",
    "@mysten-incubation/memwal": "0.1.9",
    "@mysten/sui": "2.37.0",
    "@next/env": "16.4.3",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.11.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
